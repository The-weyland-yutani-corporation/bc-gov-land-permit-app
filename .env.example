DATABASE_URL=postgresql://permit_readiness:permit_readiness@localhost:5432/permit_readiness
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNECTIONS=10

# Web authentication. Local development may omit AUTH_SESSION_SECRET; deployed
# environments must set APP_ENV, AUTH_MODE, and a strong session secret.
APP_ENV=local
AUTH_MODE=local-demo
ENABLE_SYNTHETIC_AUTH=false
AUTH_SESSION_SECRET=
ENTRA_EXTERNAL_ID_TENANT_SUBDOMAIN=
ENTRA_EXTERNAL_ID_CLIENT_ID=
ENTRA_EXTERNAL_ID_CLIENT_SECRET=
ENTRA_EXTERNAL_ID_AUTHORITY_HOST=
ENTRA_EXTERNAL_ID_REDIRECT_URI=
ENTRA_EXTERNAL_ID_ISSUER=
ENTRA_EXTERNAL_ID_ORGANIZATION_ID=
READINESS_TIMEOUT_MS=2000

# Server-side navigator adapter. The browser never calls Foundry directly.
PERMIT_AGENT_MODE=local
PERMIT_AGENT_ENDPOINT=
PERMIT_AGENT_NAME=permit-readiness-agent
PERMIT_AGENT_API_VERSION=
PERMIT_AGENT_TOKEN_SCOPE=https://ai.azure.com/.default
PERMIT_AGENT_TIMEOUT_MS=45000

# Hosted-agent curated guidance retrieval (server-side, managed identity only).
GUIDANCE_SEARCH_MODE=disabled
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=permit-guidance-v1
GUIDANCE_SEARCH_MIN_SCORE=0.2
GUIDANCE_MANIFEST_PATH=
GUIDANCE_VECTOR_DIMENSIONS=1536
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_EMBEDDING_MODEL=
