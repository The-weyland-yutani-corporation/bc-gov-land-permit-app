{
  "name": "public-sector-permit-readiness-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable public-sector permit readiness and Microsoft Foundry reference application.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:check": "pnpm --filter @permit-readiness/db db:check",
    "db:generate": "pnpm --filter @permit-readiness/db db:generate",
    "db:migrate": "pnpm --filter @permit-readiness/db migrate",
    "db:initialize": "pnpm --filter @permit-readiness/db initialize",
    "db:seed": "pnpm --filter @permit-readiness/db seed",
    "db:seed:demo": "pnpm --filter @permit-readiness/db seed:demo",
    "db:verify": "pnpm --filter @permit-readiness/db db:verify",
    "guidance:index": "pnpm --filter @permit-readiness/guidance-search index:create",
    "guidance:ingest": "pnpm --filter @permit-readiness/guidance-search ingest",
    "guidance:initialize": "pnpm --filter @permit-readiness/guidance-search initialize",
    "guidance:local": "pnpm --filter @permit-readiness/guidance-search local:test",
    "infra:validate": "node scripts/validation/validate-infra.mjs",
    "lint": "turbo run lint && node scripts/validation/validate-repo.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/validation/infra.test.mjs scripts/validation/release-routing.test.mjs scripts/validation/workflows.test.mjs",
    "test:workflows": "node --test scripts/validation/workflows.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "yaml": "2.9.1"
  }
}
