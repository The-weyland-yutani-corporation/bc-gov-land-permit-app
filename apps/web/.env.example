# Local development defaults. APP_ENV defaults to local when omitted.
APP_ENV=local
AUTH_MODE=local-demo
ENABLE_SYNTHETIC_AUTH=false
# Optional locally; generated per process when omitted. Required for deployments.
AUTH_SESSION_SECRET=

# Optional PostgreSQL/PostGIS repository. Omit for isolated in-memory demo data.
DATABASE_URL=postgresql://permit_readiness:change-me@localhost:5432/permit_readiness
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNECTIONS=10

# Optional local Azure Maps demonstration key. Do not use this browser-key mode
# in production; production must wire the managed-identity browser token adapter.
NEXT_PUBLIC_AZURE_MAPS_SUBSCRIPTION_KEY=
AZURE_MAPS_CLIENT_ID=

# Production Entra External ID confidential web application configuration.
ENTRA_EXTERNAL_ID_TENANT_SUBDOMAIN=
ENTRA_EXTERNAL_ID_CLIENT_ID=
ENTRA_EXTERNAL_ID_CLIENT_SECRET=
ENTRA_EXTERNAL_ID_AUTHORITY_HOST=
ENTRA_EXTERNAL_ID_REDIRECT_URI=
ENTRA_EXTERNAL_ID_ISSUER=
ENTRA_EXTERNAL_ID_ORGANIZATION_ID=

# Bounded readiness dependency timeout.
READINESS_TIMEOUT_MS=2000
